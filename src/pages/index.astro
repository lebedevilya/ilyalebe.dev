---
import BaseLayout from "../layouts/BaseLayout.astro";
import { visitedCountries } from "../data/travel";
import { projects } from "../data/projects";

const nodesGarden = projects.find((project) => project.title === "nodes.garden");
const recentProjects = projects.filter((project) => ["SupportOS", "slack-llm-bot"].includes(project.title));
---

<BaseLayout sideBarActiveItemID="home">
  <div class="mx-auto w-full max-w-6xl">
    <section class="py-8 sm:py-12 lg:py-16">
      <p class="mb-3 text-lg font-semibold text-primary">Senior Backend Engineer with fullstack range</p>
      <h1 class="max-w-4xl text-5xl font-bold leading-tight sm:text-6xl">Ilya Lebedev</h1>
      <p class="mt-5 max-w-3xl text-2xl font-medium leading-snug">
        I build and scale production SaaS, from backend architecture and data pipelines to frontend delivery and infrastructure.
      </p>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed opacity-75">
        8+ years across Ruby on Rails, PostgreSQL, background processing, APIs, infrastructure, and AI integrations. Former technical founder, comfortable owning ambiguous product work end to end.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/cv" class="btn btn-primary">View CV</a>
        <a href="/contact" class="btn btn-outline">Contact me</a>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm opacity-65">
        <span class="inline-flex items-center gap-2 font-semibold">
          <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
          Open to senior backend and fullstack engineering roles
        </span>
        <span aria-hidden="true">·</span>
        <span>Remote | CET timezone</span>
      </div>
    </section>

    <section aria-label="Career highlights" class="grid grid-cols-2 border-y border-base-300 sm:grid-cols-4">
      <div class="border-b border-r border-base-300 px-3 py-5 sm:border-b-0 sm:px-5">
        <div class="text-2xl font-bold">8+ years</div>
        <div class="mt-1 text-sm opacity-60">Production software</div>
      </div>
      <div class="border-b border-base-300 px-3 py-5 sm:border-b-0 sm:border-r sm:px-5">
        <div class="text-2xl font-bold">18K+ users</div>
        <div class="mt-1 text-sm opacity-60">Platform scaled</div>
      </div>
      <div class="border-r border-base-300 px-3 py-5 sm:px-5">
        <div class="text-2xl font-bold">25K+ nodes</div>
        <div class="mt-1 text-sm opacity-60">Infrastructure deployed</div>
      </div>
      <div class="px-3 py-5 sm:px-5">
        <div class="text-2xl font-bold">Techstars</div>
        <div class="mt-1 text-sm opacity-60">Web3 '25</div>
      </div>
    </section>

    <section class="py-12 lg:py-16">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-sm font-semibold text-primary">Experience</p>
          <h2 class="mt-1 text-3xl font-bold">Recent roles</h2>
        </div>
        <a href="/cv" class="link link-hover text-sm font-semibold">Full experience</a>
      </div>

      <div class="border-t border-base-300">
        <article class="grid gap-2 border-b border-base-300 py-5 md:grid-cols-[12rem_1fr] md:gap-8">
          <div>
            <h3 class="font-bold">Senior Backend Engineer</h3>
            <p class="text-sm opacity-60">orangesoft.co / 2026</p>
          </div>
          <p class="max-w-3xl leading-relaxed">
            Delivered EHR integrations, real-time messaging, admin panels, and data exports on a fixed-length contract for a US healthcare client under NDA.
          </p>
        </article>
        <article class="grid gap-2 border-b border-base-300 py-5 md:grid-cols-[12rem_1fr] md:gap-8">
          <div>
            <h3 class="font-bold">Technical Founder</h3>
            <p class="text-sm opacity-60">nodes.garden / 2025-2026</p>
          </div>
          <p class="max-w-3xl leading-relaxed">
            Built a Web3/AI infrastructure platform from zero to 18,000+ users, 25,000+ deployed nodes, and six-figure revenue. Owned architecture, product delivery, and a distributed team of ten.
          </p>
        </article>
        <article class="grid gap-2 border-b border-base-300 py-5 md:grid-cols-[12rem_1fr] md:gap-8">
          <div>
            <h3 class="font-bold">Fullstack Ruby Engineer</h3>
            <p class="text-sm opacity-60">Reinvented Hospitality / 2024-2025</p>
          </div>
          <p class="max-w-3xl leading-relaxed">
            Built and launched a Rails and Hotwire point-of-sale system in under three months, including operational workflows, tax reports, and exports.
          </p>
        </article>
        <article class="grid gap-2 border-b border-base-300 py-5 md:grid-cols-[12rem_1fr] md:gap-8">
          <div>
            <h3 class="font-bold">Backend Ruby Engineer</h3>
            <p class="text-sm opacity-60">Xometry / 2022-2024</p>
          </div>
          <p class="max-w-3xl leading-relaxed">
            Shipped regional marketplace launches, asynchronous intercompany systems, Salesforce pipelines, and an AI-assisted HS code search that reduced logistics search time by over 90%.
          </p>
        </article>
      </div>
    </section>

    {
      nodesGarden && (
        <section class="border-y border-base-300 py-12 lg:py-16">
          <p class="text-sm font-semibold text-primary">Flagship work</p>
          <div class="mt-3 grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_28rem]">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-4xl font-bold">nodes.garden</h2>
                <span class="badge badge-success">LIVE</span>
              </div>
              <p class="mt-4 max-w-2xl text-xl leading-relaxed">
                Multichain Node-as-a-Service platform built through the full company lifecycle: product discovery, Rails architecture, infrastructure automation, smart contracts, hiring, and growth.
              </p>
              <p class="mt-5 max-w-2xl leading-relaxed opacity-70">
                Reached 18,000+ users and 25,000+ deployed nodes, secured an Arbitrum ecosystem grant, and joined Techstars Web3 '25.
              </p>
              <p class="mt-4 text-sm font-medium opacity-70">
                Rails / PostgreSQL / GoodJob / Solidity / Foundry / Docker / GCP / Fly.io
              </p>
               <div class="mt-6 flex flex-wrap gap-3">
                {nodesGarden.links.slice(0, 3).map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">
                    {link.label}
                  </a>
                ))}
               </div>
            </div>
            <img
              src="/nodes-landing.webp"
              width="1400"
              height="703"
              loading="lazy"
              decoding="async"
              alt="nodes.garden landing page"
              class="h-auto w-full max-w-md rounded-lg border border-base-300"
            />
          </div>
        </section>
      )
    }

    <section class="py-12 lg:py-16">
      <p class="text-sm font-semibold text-primary">Recent technical work</p>
      <h2 class="mt-1 text-3xl font-bold">Current hands-on builds</h2>
      <p class="mt-3 max-w-2xl opacity-70">
        Smaller projects used to explore production patterns in Rails, agentic systems, RAG, and evaluation.
      </p>

      <div class="mt-7 grid gap-8 md:grid-cols-2">
        {
          recentProjects.map((project) => (
            <article class="border-t border-base-300 pt-5">
              <img
                src={project.img}
                loading="lazy"
                decoding="async"
                alt={`${project.title} preview`}
                class="h-auto w-full max-w-xs rounded-lg border border-base-300"
              />
              <div class="mt-5 flex items-center justify-between gap-3">
                <h3 class="text-xl font-bold">{project.title}</h3>
                {project.badge && <span class={`badge ${project.badgeClass}`}>{project.badge}</span>}
              </div>
              <p class="mt-2 leading-relaxed opacity-75">{project.longDesc}</p>
              {project.stack && <p class="mt-3 text-sm font-medium opacity-60">{project.stack}</p>}
              <div class="mt-4 flex flex-wrap gap-3">
                {project.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="link link-hover text-sm font-semibold">
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-y border-base-300 py-10">
      <h2 class="text-2xl font-bold">Core stack</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <div>
          <h3 class="text-sm font-bold">Backend</h3>
          <p class="mt-2 leading-relaxed opacity-70">Ruby on Rails, PostgreSQL, Sidekiq, GoodJob, REST, GraphQL</p>
        </div>
        <div>
          <h3 class="text-sm font-bold">Product and frontend</h3>
          <p class="mt-2 leading-relaxed opacity-70">TypeScript, React, Hotwire, Stimulus, Tailwind CSS</p>
        </div>
        <div>
          <h3 class="text-sm font-bold">Infrastructure and AI</h3>
          <p class="mt-2 leading-relaxed opacity-70">Docker, AWS, GCP, Fly.io, OpenAI API, RAG, LLM evaluation</p>
        </div>
      </div>
    </section>

    <section class="py-12 lg:py-16">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <div>
          <p class="text-sm font-semibold text-primary">Beyond work</p>
          <h2 class="mt-1 text-3xl font-bold">Builder on the move</h2>
          <p class="mt-4 max-w-xl text-lg leading-relaxed opacity-75">
            Currently in Vietnam after visiting {visitedCountries.length} countries. Former ETH miner with a 250+ GPU operation, PADI Advanced diver, freediver, FPV pilot, and board-game regular.
          </p>
          <a href="/travel" class="link link-hover mt-5 inline-block font-semibold">See travel map</a>
        </div>
        <div class="grid grid-cols-3 gap-3">
          {[
            ["/pic1.webp", "Ilya traveling"],
            ["/pic2.webp", "Ilya outdoors"],
            ["/pic3.webp", "Ilya diving"],
          ].map(([src, alt]) => (
            <img
              src={src}
              width="288"
              height="320"
              loading="lazy"
              decoding="async"
              alt={alt}
              class="aspect-[9/10] w-full rounded-lg object-cover"
            />
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-base-300 py-12 lg:py-16">
      <h2 class="max-w-3xl text-3xl font-bold">Looking for a senior engineer who can own the whole problem?</h2>
      <p class="mt-3 max-w-2xl text-lg opacity-70">
        I am open to full-time remote roles, strong product teams, and selective contract or technical co-founder conversations.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/cv" class="btn btn-primary">View CV</a>
        <a href="/contact" class="btn btn-outline">Get in touch</a>
      </div>
    </section>
  </div>
</BaseLayout>
