---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import DownloadPdfButton from "../components/cv/DownloadPdfButton.astro";

const arbitrumGrantUrl = "https://arbitrum.questbook.app/dashboard/?grantId=67d7ff7f46da2f90cc3205e9&role=community&chainId=10&proposalId=68d6c5b2306fa3a0a647b6bb&isRenderingProposalBody=true";
const techstarsWeb3Url = "https://www.techstars.com/newsroom/announcing-the-techstars-web3-class-of-2025";

// FAQPage JSON-LD: answer-engine optimisation for Perplexity, ChatGPT search,
// Google's AI overviews. Each question is a typical recruiter inquiry; the
// answer is short, citable, and links to the canonical source where useful.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How many years of experience does Ilya Lebedev have?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "8+ years building production Ruby on Rails applications end-to-end. Senior roles at Xometry (manufacturing marketplace, two years), Reinvented Hospitality (built and launched a full POS in three months), and Orangesoft (senior backend on US healthcare client). Technical founder of nodes.garden."
      }
    },
    {
      "@type": "Question",
      "name": "Is Ilya available for hire?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, currently open to senior fullstack contract work and technical co-founder conversations. Based in Tbilisi, Georgia; remote, US/EU time zones, B2B contract. The fastest way to start a conversation is the 30-minute Calendly slot at https://calendly.com/ilya0lebedev/30min."
      }
    },
    {
      "@type": "Question",
      "name": "What technology stack does Ilya specialise in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ruby on Rails primarily, with Hotwire (Turbo + Stimulus) and React on the frontend. PostgreSQL, Redis, Sidekiq / GoodJob for data and background work. Recent work also covers TypeScript, OpenAI tool-loops, RAG pipelines with pgvector, and Solidity, Foundry, OpenZeppelin, ethers.js on the Web3 side."
      }
    },
    {
      "@type": "Question",
      "name": "Does Ilya have founder experience?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Founded nodes.garden, a Web3/AI Node-as-a-Service platform scaled to 18,000+ users and 25,000+ deployed nodes. Secured an Arbitrum ecosystem grant, shipped Node NFT smart contracts and a marketplace, and was selected for the Techstars Web3 '25 cohort along with XFounders Season 4 and Founder.University Cohort 9."
      }
    },
    {
      "@type": "Question",
      "name": "What is Ilya's experience with LLMs and applied AI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Production LLM orchestration work including the open-source slack-llm-bot at https://github.com/lebedevilya/slack-llm-bot (OpenAI tool-loop, threaded memory, optional pgvector long-term recall, offline eval harness with a deterministic oracle and LLM judge). Previously built customs.codes, a RAG-based AI search tool for customs codes that was a Backdrop Build V3 finalist."
      }
    },
    {
      "@type": "Question",
      "name": "Where is Ilya based?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Digital nomad. Available for B2B contract engagements globally; comfortable working both US and EU time zones."
      }
    },
    {
      "@type": "Question",
      "name": "What is Ilya's educational background?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "M.Sc. in Applied Mathematics and Computer Science, Saint Petersburg State University (2019). Selected programs since: Techstars Web3 '25, XFounders Season 4 (2025), Founder.University Cohort 9 (2025)."
      }
    },
    {
      "@type": "Question",
      "name": "How can someone get in touch with Ilya?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Book a 30-minute call at https://calendly.com/ilya0lebedev/30min, or message via LinkedIn for professional inquiries. Telegram (@rubyminer) for casual chats. Full options at https://ilyalebe.dev/contact."
      }
    }
  ]
};
---

<BaseLayout title="Resume | Ilya Lebedev" description="Resume of Ilya Lebedev: Senior fullstack/product engineer, ex-founder (Techstars Web3 '25). Full timeline of experience, education, programs, and selected projects." sideBarActiveItemID="cv" mainClass="cv-page">

  <DownloadPdfButton />

  <!-- HEADER: name first so ATS parsers pick it up -->
  <div class="mb-5">
    <h1 class="text-3xl font-bold">Ilya Lebedev</h1>
    <div class="text-xl font-semibold">Senior Software Engineer</div>
  </div>

  <div id="contact" class="mb-10">
    Tbilisi, Georgia · Remote (US/EU time zones), B2B contract · Russian (Native), English (C2), Spanish (A1)<br>
    <a href="mailto:ilya0lebedev@gmail.com">ilya0lebedev@gmail.com</a> ·
    <a href="https://ilyalebe.dev">ilyalebe.dev</a> ·
    <a href="https://www.linkedin.com/in/ilya-lebedev-554225102/">linkedin.com/in/ilya-lebedev-554225102</a> ·
    <a href="https://github.com/lebedevilya">github.com/lebedevilya</a> ·
    Telegram: @rubyminer
  </div>

  <!-- PROFILE -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Profile</h2>
  </div>

  <div class="mb-10 text-justify">
    Senior software engineer with 8+ years building and scaling production SaaS systems and distributed infrastructure. Ex-founder (<a href={techstarsWeb3Url}>Techstars Web3 '25</a>): built and scaled an infrastructure-heavy platform to 18,000+ users and 25,000+ deployed nodes. Fluent across Ruby, Python and JavaScript on APIs (REST/GraphQL), background workers, data pipelines and integrations. Hands-on with LLM orchestration, RAG and AI coding tools; happy to pick up any tech stack.
  </div>

  <!-- EXPERIENCE -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Experience</h2>
  </div>

  <div class="time-line-container mb-5">
    <!-- ORANGESOFT -->
    <TimeLineElement
      title="Backend Ruby Engineer (Contract)"
      subtitle="Feb 2026 – Jun 2026 — Orangesoft (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Delivered backend features on a fixed-length contract for an outsourcing client in the US healthcare segment (under NDA).</li>
        <li>Built and maintained integrations with Electronic Health Record (EHR) systems for secure patient and clinical data exchange.</li>
        <li>Implemented the backend architecture for real-time messaging and chat workflows.</li>
        <li>Developed administrative panels, operational tooling, and compliant data export pipelines.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, Sidekiq, Redis, REST APIs, RSpec, Docker
      </span>
    </TimeLineElement>

    <!-- NODES.GARDEN -->
    <TimeLineElement
      title="Technical Founder"
      subtitle="Mar 2025 – Feb 2026 — nodes.garden (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Founded and led the technical development of Web3/AI node as a service platform.</li>
        <li>Built APIs and internal tooling used for managing large-scale infrastructure. 25,000+ nodes deployed in a year.</li>
        <li>Scaled platform from 0 to 18,000+ users and six-figure revenue.</li>
        <li>Secured an <a href={arbitrumGrantUrl}>Arbitrum ecosystem grant</a> and implemented Node NFT smart contracts and marketplace.</li>
        <li>Owned backend architecture, core domain modeling, background processing.</li>
        <li>Built browser automation and data collection workflows with proxy handling, retries and failure recovery.</li>
        <li>Assembled and managed a distributed team of 10 people including engineers, customer support, BD.</li>
        <li>Completed <a href={techstarsWeb3Url}>Techstars Web3 2025</a>, XFounders Season 4 and Founder.University Cohort 9 programs.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, RSpec, GoodJob, Hotwire, TailwindCSS, Solidity, Foundry, OpenZeppelin, ethers.js, MetaMask, JSON-RPC, Arbitrum, Docker, fly.io
      </span>
    </TimeLineElement>

    <!-- REINVENTED HOSPITALITY -->
    <TimeLineElement
      title="Fullstack Ruby Engineer"
      subtitle="Aug 2024 – Mar 2025 — Reinvented Hospitality (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Built and launched a full-cycle POS system (Rails + Hotwire) in under 3 months.</li>
        <li>Designed and delivered core domain features for restaurant and hotel operations.</li>
        <li>Delivered tax reports, data exports and operational tooling.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, Sidekiq, Hotwire, MiniTest, TailwindCSS, ViewComponent, AWS, Docker
      </span>
    </TimeLineElement>

    <!-- XOMETRY -->
    <TimeLineElement
      title="Backend Ruby Engineer"
      subtitle="Aug 2022 – Aug 2024 — Xometry (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Contributed to backend architecture of a manufacturing marketplace with thousands of buyers and suppliers globally.</li>
        <li>Implemented & launched UK and TR regional apps under tight deadlines (1 month).</li>
        <li>Built AI-powered HS codes search tool which cut down code search time for logistics team by 90%+</li>
        <li>Designed and implemented async intercompany communication systems with background processing and data consistency.</li>
        <li>Fully owned & managed Salesforce integrations/pipelines.</li>
        <li>Built foundational domain systems (HS codes, manufacturing attributes, pricing logic).</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, React, RSpec, PostgreSQL, Sidekiq, GraphQL, RabbitMQ, Redis, Python, Airflow
      </span>
    </TimeLineElement>

    <!-- EARLIER EXPERIENCE -->
    <TimeLineElement
      title="Backend Ruby Engineer"
      subtitle="2019 – 2021 — Sputnik8, Igooods, Rubyroid Labs (remote)"
    >
      Backend development across e-commerce, travel, insurance, and internal tooling products. Both in-house and outsourcing projects from EU/US.
      <br>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, React, VueJS, RSpec, PostgreSQL, Sidekiq, GraphQL, REST APIs, Heroku, AWS
      </span>
    </TimeLineElement>

    <TimeLineElement
      title="Internships & Early Career"
      subtitle="2017 – 2019"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>
          Yandex: Web Developer Intern. Python, React, GraphQL.
        </li>
        <li>
          Joint Institute for Nuclear Research: C++/CUDA Developer Intern.
        </li>
        <li>
          WorldQuant: Quantitative Research Consultant.
        </li>
      </ul>
    </TimeLineElement>
  </div>

  <!-- PROJECTS -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Selected Projects</h2>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li><b>SupportOS</b> (Ruby on Rails, Hotwire): agentic support for startup portfolios. <a href="https://supportos.ilyalebe.dev">supportos.ilyalebe.dev</a></li>
    <li><b>slack-llm-bot</b> (TypeScript, Vercel): Slack bot with an OpenAI tool loop, threaded memory, Supabase pgvector recall and an offline LLM eval harness. <a href="https://github.com/lebedevilya/slack-llm-bot">github.com/lebedevilya/slack-llm-bot</a></li>
    <li><b>nodes.garden</b> (Ruby on Rails, Solidity): Web3/AI node-as-a-service platform, Backdrop Build V4–V6 finalist. Built by hand before AI coding tools.</li>
    <li><b>customs.codes</b> (Ruby on Rails, RAG): AI customs code classification tool, Backdrop Build V3 finalist. Built by hand before AI coding tools.</li>
  </ul>

  <!-- SKILLS -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Core Skills</h2>
  </div>

  <ul class="list-disc md:columns-3 columns-2 mx-6 mb-10">
    <li><b>Languages:</b> Ruby, JavaScript, Python</li>
    <li><b>Backend:</b> REST/GraphQL APIs, distributed systems, domain modeling, scalability, performance optimization</li>
    <li><b>Web3:</b> Solidity, ERC-721, Foundry, OpenZeppelin, ethers.js, JSON-RPC</li>
    <li><b>Databases:</b> PostgreSQL, Redis</li>
    <li><b>Async:</b> Sidekiq, SolidQueue, RabbitMQ</li>
    <li><b>Infra:</b> Docker, CI/CD, AWS, GCP, fly.io, Heroku, Kamal</li>
    <li><b>Observability:</b> Datadog, Sentry, Appsignal</li>
    <li><b>Frontend:</b> Hotwire, React, ViewComponent, TailwindCSS</li>
    <li><b>AI:</b> LLM integrations, RAG, vector DBs</li>
    <li><b>Payments:</b> Stripe, PayPal, CloudPayments, Copperx & others</li>
  </ul>

  <!-- EDUCATION -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Education & Programs</h2>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li><b>M.Sc. Applied Mathematics and Computer Science</b>, Saint Petersburg State University, 2017–2019</li>
    <li><b>B.Sc. Applied Mathematics and Computer Science</b>, Saint Petersburg State University, 2013–2017</li>
    <li><b>Startup programs:</b> <a href={techstarsWeb3Url}>Techstars Web3 '25</a> (Dublin & London), XFounders Season 4 (with Starknet Foundation), Founder.University Cohort 9</li>
  </ul>

  <!-- FAQ structured data (invisible to humans; consumed by Perplexity, ChatGPT search, Google AI overviews) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

</BaseLayout>
