---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import DownloadPdfButton from "../components/cv/DownloadPdfButton.astro";

const arbitrumGrantUrl = "https://arbitrum.questbook.app/dashboard/?grantId=67d7ff7f46da2f90cc3205e9&role=community&chainId=10&proposalId=68d6c5b2306fa3a0a647b6bb&isRenderingProposalBody=true";
const techstarsWeb3Url = "https://www.techstars.com/newsroom/announcing-the-techstars-web3-class-of-2025";
---

<BaseLayout title="Fullstack Resume | Ilya Lebedev" description="Senior Fullstack Engineer resume of Ilya Lebedev (Ruby on Rails, Hotwire, React). 8+ years shipping product end-to-end; ex-founder, Techstars Web3 '25." sideBarActiveItemID="cv" mainClass="cv-page">

  <DownloadPdfButton />

  <!-- HEADER: name first so ATS parsers pick it up -->
  <div class="mb-5">
    <h1 class="text-3xl font-bold">Ilya Lebedev</h1>
    <div class="text-xl font-semibold">Senior Fullstack Engineer (Ruby on Rails, Hotwire, React)</div>
  </div>

  <div class="mb-10">
    Tbilisi, Georgia · Remote (US/EU time zones), B2B contract · Russian (Native), English (C2), Spanish (A1)<br>
    <a href="mailto:ilya0lebedev@gmail.com">ilya0lebedev@gmail.com</a> ·
    <a href="https://ilyalebe.dev">ilyalebe.dev</a> ·
    <a href="https://www.linkedin.com/in/ilya-lebedev-554225102/">linkedin.com/in/ilya-lebedev-554225102</a> ·
    <a href="https://github.com/lebedevilya">github.com/lebedevilya</a> ·
    Telegram: @rubyminer
  </div>

  <!-- PROFILE -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Profile</h2>
  </div>

  <div class="mb-10 text-justify">
    Senior fullstack/product engineer with 8+ years shipping SaaS products end-to-end.
    Ex-founder (<a href={techstarsWeb3Url}>Techstars Web3 '25</a>): built and scaled an infrastructure-heavy platform to 18,000+ users and 25,000+ deployed nodes.
    Fluent across Ruby, Python and JavaScript end-to-end (UI through APIs and infrastructure); ship features without overcomplicating the stack. Hands-on with LLM orchestration, RAG and AI coding tools; happy to pick up any tech stack.
  </div>

  <!-- EXPERIENCE -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Experience</h2>
  </div>

  <div class="time-line-container mb-5">
    <!-- ORANGESOFT -->
    <TimeLineElement
      title="Fullstack Ruby Engineer (Contract)"
      subtitle="Feb 2026 – Jun 2026 — Orangesoft (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Delivered end-to-end features on a fixed-length contract for an outsourcing client in the US healthcare segment (under NDA).</li>
        <li>Built backend integrations with Electronic Health Record (EHR) systems for secure clinical and patient data workflows.</li>
        <li>Implemented real-time chat and messaging features with backend and frontend integration.</li>
        <li>Developed comprehensive admin panels, internal management tools, and healthcare data export flows.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, Hotwire, Sidekiq, Redis, REST APIs, RSpec, Docker
      </span>
    </TimeLineElement>

    <!-- NODES.GARDEN -->
    <TimeLineElement
      title="Fullstack Engineer / Founder"
      subtitle="Mar 2025 – Feb 2026 — nodes.garden (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Founded and led the product and technical development of a Web3/AI platform built with Ruby on Rails, Hotwire, PostgreSQL.</li>
        <li>Built end-to-end workflows, APIs and internal tooling used to manage large-scale infrastructure. 25,000+ nodes deployed in a year.</li>
        <li>Scaled the platform from 0 to 18,000+ users and $350k yearly revenue.</li>
        <li>Secured an <a href={arbitrumGrantUrl}>Arbitrum ecosystem grant</a> and implemented Node NFT smart contracts and marketplace.</li>
        <li>Built browser automation and data collection workflows with proxy handling, retries and failure recovery.</li>
        <li>Assembled and managed a distributed team of 10 people including engineers, customer support and business development.</li>
        <li>Completed <a href={techstarsWeb3Url}>Techstars Web3 2025</a>, XFounders Season 4 and Founder.University Cohort 9 programs.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, RSpec, GoodJob, Hotwire, TailwindCSS, Solidity, Foundry, OpenZeppelin, ethers.js, MetaMask, JSON-RPC, Arbitrum, Docker, fly.io
      </span>
    </TimeLineElement>

    <!-- REINVENTED HOSPITALITY -->
    <TimeLineElement
      title="Fullstack Ruby Engineer"
      subtitle="Aug 2024 – Mar 2025 — Reinvented Hospitality (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Built and launched a full-cycle POS system with Rails + Hotwire in under 3 months.</li>
        <li>Designed and delivered user-facing flows for restaurant and hotel operations.</li>
        <li>Shipped tax reports, data exports and internal operational tooling.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, Sidekiq, Hotwire, MiniTest, TailwindCSS, ViewComponent, AWS, Docker
      </span>
    </TimeLineElement>

    <!-- XOMETRY -->
    <TimeLineElement
      title="Fullstack Ruby Engineer"
      subtitle="Aug 2022 – Aug 2024 — Xometry (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Shipped user-facing product flows for a large manufacturing marketplace serving hundreds of thousands of buyers and suppliers globally.</li>
        <li>Implemented and launched UK and TR regional product experiences under tight deadlines.</li>
        <li>Built an AI-powered HS codes search tool that cut code search time for the logistics team by 90%+.</li>
        <li>Delivered end-to-end order, quoting and logistics flows with supporting backend services and background processing.</li>
        <li>Owned key workflows across the stack, from UI behavior and API contracts to data consistency.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, React, RSpec, PostgreSQL, Sidekiq, GraphQL, RabbitMQ, Redis, Python, Airflow
      </span>
    </TimeLineElement>

    <!-- EARLIER EXPERIENCE -->
    <TimeLineElement
      title="Fullstack Ruby Engineer"
      subtitle="2019 – 2021 — Sputnik8, Igooods, Rubyroid Labs (remote)"
    >
      Fullstack development across e-commerce, travel, insurance and internal tooling products, with ownership of user-facing features, backend work and business-critical integrations.
      <br>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, React, VueJS, RSpec, PostgreSQL, Sidekiq, GraphQL, REST APIs, Heroku, AWS
      </span>
    </TimeLineElement>

    <TimeLineElement
      title="Internships & Early Career"
      subtitle="2017 – 2019"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>
          Yandex: Web Developer Intern. Python, React, GraphQL.
        </li>
        <li>
          Joint Institute for Nuclear Research: C++/CUDA Developer Intern.
        </li>
        <li>
          WorldQuant: Quantitative Research Consultant.
        </li>
      </ul>
    </TimeLineElement>
  </div>

  <!-- PROJECTS -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Selected Projects</h2>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li><b>slack-llm-bot</b> (TypeScript, Vercel): Slack bot with an OpenAI tool loop, threaded memory, Supabase pgvector recall and an offline LLM eval harness. <a href="https://github.com/lebedevilya/slack-llm-bot">github.com/lebedevilya/slack-llm-bot</a></li>
    <li><b>nodes.garden</b> (Ruby on Rails, Solidity): Web3/AI node-as-a-service platform, Backdrop Build V4–V6 finalist. Built by hand before AI coding tools.</li>
    <li><b>customs.codes</b> (Ruby on Rails, RAG): AI customs code classification tool, Backdrop Build V3 finalist. Built by hand before AI coding tools.</li>
  </ul>

  <!-- SKILLS -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Core Skills</h2>
  </div>

  <ul class="list-disc md:columns-3 columns-2 mx-6 mb-10">
    <li><b>Languages:</b> Ruby, JavaScript, Python</li>
    <li><b>Frontend:</b> Hotwire, React, Vue, ViewComponent, TailwindCSS</li>
    <li><b>Backend:</b> Ruby on Rails, REST/GraphQL APIs, domain modeling</li>
    <li><b>Web3:</b> Solidity, ERC-721, Foundry, OpenZeppelin, ethers.js, JSON-RPC</li>
    <li><b>Databases:</b> PostgreSQL, Redis</li>
    <li><b>Async:</b> Sidekiq, SolidQueue, RabbitMQ</li>
    <li><b>Infra:</b> Docker, CI/CD, AWS, GCP, fly.io, Heroku, Kamal</li>
    <li><b>Observability:</b> Datadog, Sentry, Appsignal</li>
    <li><b>Other:</b> Salesforce, Stripe, PayPal, CloudPayments, Copperx</li>
  </ul>

  <!-- EDUCATION -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Education & Programs</h2>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li><b>M.Sc. Applied Mathematics and Computer Science</b>, Saint Petersburg State University, 2017–2019</li>
    <li><b>B.Sc. Applied Mathematics and Computer Science</b>, Saint Petersburg State University, 2013–2017</li>
    <li><b>Startup programs:</b> <a href={techstarsWeb3Url}>Techstars Web3 '25</a> (Dublin & London), XFounders Season 4 (with Starknet Foundation), Founder.University Cohort 9</li>
  </ul>

</BaseLayout>
