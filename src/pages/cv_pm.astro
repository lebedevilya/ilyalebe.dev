---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import DownloadPdfButton from "../components/cv/DownloadPdfButton.astro";

const arbitrumGrantUrl = "https://arbitrum.questbook.app/dashboard/?grantId=67d7ff7f46da2f90cc3205e9&role=community&chainId=10&proposalId=68d6c5b2306fa3a0a647b6bb&isRenderingProposalBody=true";
const techstarsWeb3Url = "https://www.techstars.com/newsroom/announcing-the-techstars-web3-class-of-2025";
---

<BaseLayout title="PM Resume | Ilya Lebedev" description="Product/PM angle on Ilya Lebedev's career: founder track record, cross-functional delivery, workflow-heavy product execution. Techstars Web3 '25." sideBarActiveItemID="cv" mainClass="cv-page">

  <DownloadPdfButton />

  <!-- HEADER: name first so ATS parsers pick it up -->
  <div class="mb-5">
    <h1 class="text-3xl font-bold">Ilya Lebedev</h1>
    <div class="text-xl font-semibold">Technical Product Manager / Product Owner</div>
  </div>

  <div class="mb-10">
    Tbilisi, Georgia · Remote (US/EU time zones), B2B contract · Russian (Native), English (C2), Spanish (A1)<br>
    <a href="mailto:ilya0lebedev@gmail.com">ilya0lebedev@gmail.com</a> ·
    <a href="https://ilyalebe.dev">ilyalebe.dev</a> ·
    <a href="https://www.linkedin.com/in/ilya-lebedev-554225102/">linkedin.com/in/ilya-lebedev-554225102</a> ·
    <a href="https://github.com/lebedevilya">github.com/lebedevilya</a> ·
    Telegram: @rubyminer
  </div>

  <!-- PROFILE -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Profile</h2>
  </div>

  <div class="mb-10 text-justify">
    Technical product operator with 8+ years of experience building and running infrastructure-heavy software products.
    Ex-founder (<a href={techstarsWeb3Url}>Techstars Web3 '25</a>): built and scaled a Web3/AI platform to 18,000+ users and 25,000+ deployed nodes, and owned product direction, prioritization, execution, and operational reliability across product, engineering, and support.
    Hands-on with LLM orchestration, RAG and AI tooling; fluent in the engineering language across Ruby, Python and JavaScript. Looking for product roles that need technical fluency, systems thinking and strong execution in infrastructure-heavy, workflow-heavy and operations-sensitive domains.
  </div>

  <!-- EXPERIENCE -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Experience</h2>
  </div>

  <div class="time-line-container mb-5">
    <!-- ORANGESOFT -->
    <TimeLineElement
      title="Senior Backend Engineer / Technical Consultant (Contract)"
      subtitle="Feb 2026 – Jun 2026 — Orangesoft (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Executed a fixed-length engineering contract for an outsourcing client in the US healthcare sector (under NDA).</li>
        <li>Navigated complex healthcare domain requirements, including Electronic Health Record (EHR) integrations and data compliance.</li>
        <li>Delivered core product capabilities: real-time chats & messaging infrastructure, admin tooling, and data export workflows.</li>
        <li>Collaborated closely with US client stakeholders and cross-functional teams to ensure on-time delivery within project scope.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, Sidekiq, Redis, REST APIs, RSpec, Docker
      </span>
    </TimeLineElement>

    <!-- NODES.GARDEN -->
    <TimeLineElement
      title="Founder / Product Lead"
      subtitle="Mar 2025 – Feb 2026 — nodes.garden (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Led product direction, prioritization and technical execution for a Web3/AI infrastructure platform.</li>
        <li>Defined roadmap and shipped workflow-heavy product features for node operations, orchestration and support tooling.</li>
        <li>Scaled the platform from 0 to 18,000+ users, 25,000+ deployed nodes and $350K yearly revenue.</li>
        <li>Secured an <a href={arbitrumGrantUrl}>Arbitrum ecosystem grant</a> and implemented Node NFT smart contracts and marketplace.</li>
        <li>Assembled and managed a distributed team of 10 people including engineers, customer support, BD and operations.</li>
        <li>Completed <a href={techstarsWeb3Url}>Techstars Web3 2025</a>, XFounders Season 4 and Founder.University Cohort 9 programs.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, RSpec, GoodJob, Hotwire, TailwindCSS, Solidity, Foundry, OpenZeppelin, ethers.js, MetaMask, JSON-RPC, Arbitrum, Docker, fly.io
      </span>
    </TimeLineElement>

    <!-- REINVENTED HOSPITALITY -->
    <TimeLineElement
      title="Fullstack Ruby Engineer"
      subtitle="Aug 2024 – Mar 2025 — Reinvented Hospitality (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Built and launched a full-cycle POS system with Rails + Hotwire in under 3 months.</li>
        <li>Helped shape and deliver workflow-heavy features for restaurant and hotel operations.</li>
        <li>Shipped tax reports, data exports, and internal operational tooling.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, PostgreSQL, Sidekiq, Hotwire, MiniTest, TailwindCSS, ViewComponent, AWS, Docker
      </span>
    </TimeLineElement>

    <!-- XOMETRY -->
    <TimeLineElement
      title="Backend Ruby Engineer"
      subtitle="Aug 2022 – Aug 2024 — Xometry (remote)"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>Helped scale backend architecture for a global manufacturing marketplace supporting transactions across hundreds of thousands of buyers and suppliers.</li>
        <li>Implemented and launched UK and TR regional apps under tight deadlines (1 month).</li>
        <li>Built an AI-powered HS codes search tool which cut code search time for the logistics team by 90%+.</li>
        <li>Designed and implemented async intercompany communication systems that kept operational workflows consistent.</li>
      </ul>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, React, RSpec, PostgreSQL, Sidekiq, GraphQL, RabbitMQ, Redis, Python, Airflow
      </span>
    </TimeLineElement>

    <!-- EARLIER EXPERIENCE -->
    <TimeLineElement
      title="Backend Ruby Engineer"
      subtitle="2019 – 2021 — Sputnik8, Igooods, Rubyroid Labs (remote)"
    >
      Backend work across e-commerce, travel, insurance and internal tooling products, with ownership of integrations, data flows, and production-facing operational work.
      <br>
      <span class="text-sm font-light">
        Tech: Ruby on Rails, React, VueJS, RSpec, PostgreSQL, Sidekiq, GraphQL, REST APIs, Heroku, AWS
      </span>
    </TimeLineElement>

    <TimeLineElement
      title="Internships & Early Career"
      subtitle="2017 – 2019"
    >
      <ul class="list-disc mx-6 mb-2 grid gap-2">
        <li>
          Yandex: Web Developer Intern. Python, React, GraphQL.
        </li>
        <li>
          Joint Institute for Nuclear Research: C++/CUDA Developer Intern.
        </li>
        <li>
          WorldQuant: Quantitative Research Consultant.
        </li>
      </ul>
    </TimeLineElement>
  </div>

  <!-- PROJECTS -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Selected Projects</h2>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li><b>slack-llm-bot</b> (TypeScript, Vercel): open-source Slack bot that ships LLM features behind an offline regression suite (deterministic oracle + LLM judge), so behaviour changes trace to code. <a href="https://github.com/lebedevilya/slack-llm-bot">github.com/lebedevilya/slack-llm-bot</a></li>
    <li><b>nodes.garden</b> (Ruby on Rails, Solidity): Web3/AI node-as-a-service platform, Backdrop Build V4–V6 finalist. Built by hand before AI coding tools.</li>
    <li><b>customs.codes</b> (Ruby on Rails, RAG): AI customs code classification tool, Backdrop Build V3 finalist. Built by hand before AI coding tools.</li>
  </ul>

  <!-- SKILLS -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Core Skills</h2>
  </div>

  <ul class="list-disc md:columns-3 columns-2 mx-6 mb-10">
    <li><b>Languages:</b> Ruby, JavaScript, Python</li>
    <li><b>Product:</b> Discovery, prioritization, roadmap ownership, product execution</li>
    <li><b>Execution:</b> Cross-functional delivery, operational tooling, workflow-heavy products</li>
    <li><b>Technical fluency:</b> Ruby on Rails, REST/GraphQL APIs, domain modeling</li>
    <li><b>Web3:</b> Solidity, ERC-721, Foundry, OpenZeppelin, ethers.js, JSON-RPC</li>
    <li><b>Systems:</b> PostgreSQL, Redis, Sidekiq, SolidQueue, RabbitMQ</li>
    <li><b>Infra:</b> Docker, CI/CD, AWS, GCP, fly.io, Heroku, Kamal</li>
    <li><b>Reliability:</b> Datadog, Sentry, Appsignal</li>
    <li><b>Adjacent domains:</b> Salesforce, Stripe, PayPal, CloudPayments, Copperx, LLM integrations</li>
  </ul>

  <!-- EDUCATION -->
  <div class="mb-5">
    <h2 class="text-3xl font-bold">Education & Programs</h2>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li><b>M.Sc. Applied Mathematics and Computer Science</b>, Saint Petersburg State University, 2017–2019</li>
    <li><b>B.Sc. Applied Mathematics and Computer Science</b>, Saint Petersburg State University, 2013–2017</li>
    <li><b>Startup programs:</b> <a href={techstarsWeb3Url}>Techstars Web3 '25</a> (Dublin & London), XFounders Season 4 (with Starknet Foundation), Founder.University Cohort 9</li>
  </ul>

</BaseLayout>
